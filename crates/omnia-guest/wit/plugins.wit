package omnia:plugins@0.1.0;

/// Host-side plugin loading. Request-only in both directions: the guest names
/// code, the host acquires, verifies, validates, and registers it — component
/// bytes never cross this interface.
interface loader {
    /// Where the deployment's acquirer finds a package's component bytes.
    variant location {
        /// A package registry; `none` selects the acquirer's default.
        registry(option<string>),
        /// A location-relative component path, read fresh on every load.
        path(string),
    }

    /// Why a load was refused.
    variant error {
        /// The request or deployment is wrong and a retry cannot succeed:
        /// an unserved location kind, a malformed or mismatched digest pin,
        /// or bytes that are not a raw wasm component (a pre-compiled native
        /// artifact is always refused) or failed validation.
        refused(string),
        /// The acquirer could not produce the package bytes; the source may
        /// recover, so a retry can succeed.
        unavailable(string),
        /// The package identity is already registered and cannot be re-bound.
        already-active(string),
        /// Loader misconfiguration or an internal registration failure.
        internal(string),
    }

    /// A loaded plugin: a plain value, because the requester holds no
    /// lifecycle authority over the loaded component.
    record plugin {
        /// The registered guest identity (routes both link dispatch and the
        /// host Dispatcher).
        id: string,
        /// The resolved `sha256:<hex>` content digest of the loaded bytes —
        /// commit it as a pin to make an unpinned load reproducible.
        digest: string,
    }

    /// Load `package`, idempotent on (package, digest): an already-active
    /// package returns its handle immediately. The host acquires through the
    /// builder-supplied acquirer, verifies the sha256 pin when given,
    /// validates raw wasm, and registers under `package`.
    load: async func(%package: string, %from: location, digest: option<string>) -> result<plugin, error>;
}

world imports {
    import loader;
}
