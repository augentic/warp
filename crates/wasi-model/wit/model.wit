package omnia:model@0.1.0;

/// Models-API-style prompt completion.
interface completion {
    use wasi:filesystem/types@0.3.0.{descriptor};

    /// A JSON document.
    type json = string;

    /// The text the guest's check accepted — or, without a check, the
    /// model's final text as the backend received it.
    type answer = string;

    /// Chat turn author.
    enum role {
        system,
        user,
        assistant,
    }

    /// One chat turn.
    record message {
        role: role,
        content: string,
    }

    /// JSON Schema steering output (`response_format.json_schema` in provider APIs).
    record schema {
        /// Schema name passed to the provider.
        name: string,
        /// JSON Schema document the answer should conform to.
        schema: json,
    }

    /// Output shape hint steering the provider (`response_format` where the
    /// provider constrains decoding, instruction prose where it does not).
    /// Nothing is validated against it; acceptance is the guest's check.
    variant format {
        text,
        /// Steer toward a JSON object.
        json,
        /// Steer toward the given JSON Schema.
        schema(schema),
    }

    /// Reasoning-effort hint for models with a thinking budget.
    enum effort {
        minimal,
        low,
        medium,
        high,
    }

    /// Sampling and length controls. Omitted fields defer to backend defaults.
    record generation {
        temperature: option<f32>,
        top-p: option<f32>,
        max-tokens: option<u32>,
        stop: list<string>,
        seed: option<u64>,
        effort: option<effort>,
    }

    /// Guest-declared function tool advertised to the model.
    record function {
        /// Must not collide with the reserved names (`read`, `list`, `write`, `check`).
        name: string,
        /// Natural-language description for the model.
        description: string,
        /// JSON Schema for the arguments object.
        parameters: json,
    }

    /// Remote MCP server offered to the model.
    record mcp {
        /// Logical server name.
        name: string,
        /// Tool allowlist; empty exposes every tool the server advertises.
        tools: list<string>,
        url: string,
    }

    /// A tool offered to the model.
    variant tool {
        function(function),
        mcp(mcp),
    }

    /// One lent workspace: an authorized mount root plus a relative subpath
    /// scoping the lend.
    record workspace-grant {
        /// Must be an authorized mount root.
        root: borrow<descriptor>,
        /// `/`-separated path beneath `root`; empty lends the root itself.
        /// Reopened beneath the verified root, so it can never escape the mount.
        subpath: string,
    }

    /// Capabilities lent for this completion; drives host-injected tools.
    record grants {
        workspace: option<workspace-grant>,
    }

    /// One complete request.
    record request {
        /// Opaque model id hint; passed through unchanged, backend may override.
        model: option<string>,
        system: option<string>,
        /// Must not be empty.
        messages: list<message>,
        generation: option<generation>,
        format: format,
        /// Merged with host-injected tools at the backend. The names `read`,
        /// `list`, `write`, and `check` are reserved.
        tools: list<tool>,
        grants: grants,
        /// Ask the guest to accept each candidate answer before it becomes
        /// the reply. The candidate arrives on `session.calls` as a tool-call
        /// named `check` whose arguments are the candidate text; `ok` accepts
        /// it, `err(text)` is appended to the conversation verbatim as the
        /// correction turn and the backend goes round again.
        check: bool,
    }

    /// Token accounting, when the backend reports it.
    record usage {
        input-tokens: u32,
        output-tokens: u32,
        /// Reasoning tokens, for models that bill them separately.
        reasoning-tokens: option<u32>,
    }

    /// One completion result.
    record reply {
        answer: answer,
        usage: option<usage>,
    }

    /// One tool invocation the model asks the guest to run.
    record tool-call {
        /// Correlation id: calls are parallel and results unordered, so
        /// results answer calls by `id`.
        id: string,
        /// A function-tool name declared in `request.tools`, or the reserved
        /// `check` when `request.check` is set.
        name: string,
        /// Arguments object, per the tool's declared parameters schema.
        arguments: json,
    }

    /// The guest's answer to one `tool-call`.
    record tool-result {
        id: string,
        /// Tool output, or a model-visible failure the model may repair from.
        output: result<json, string>,
    }

    /// Typed completion failure.
    variant error {
        /// Malformed request; retrying unchanged is pointless.
        invalid-request(string),
        /// Iteration, token, or time budget exhausted. When the last round
        /// ended on a rejected check, the detail is that `err` text.
        budget-exhausted(string),
        /// Non-repairable tool error.
        tool-failed(string),
        /// Transport, process, or provider failure.
        backend(string),
    }

    /// One open completion. The host always resolves `reply` — budget and
    /// deadline failures arrive as `error` values, never as a dropped writer.
    record session {
        /// Closes when the completion finishes or its call budget is exhausted.
        calls: stream<tool-call>,
        reply: future<result<reply, error>>,
    }

    /// Open a completion session. The guest creates the `results` stream,
    /// keeps the writer, and passes the readable end.
    create: async func(request: request, results: stream<tool-result>) -> result<session, error>;
}

world model {
    import completion;
}
